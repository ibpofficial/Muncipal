datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator serverClient {
  provider = "prisma-client-js"
  output   = "../server/node_modules/@prisma/client"
}

model User {
  id                  String               @id @default(uuid())
  publicId            String               @unique
  firebaseUid         String               @unique
  name                String
  email               String               @unique
  role                String               @default("USER") // USER, PROFESSIONAL, AUTHORITY, WORKER
  requestedRole       String?
  accountStatus       String               @default("ACTIVE") // ACTIVE, PENDING_APPROVAL, SUSPENDED
  emailVerified       Boolean              @default(false)
  profileCompleted    Boolean              @default(false)
  authProvider        String               @default("password") // password, google
  photoUrl            String?
  lastLoginAt         DateTime?
  crewId              String?
  crew                Crew?                @relation(fields: [crewId], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  userProfile         UserProfile?
  professionalProfile ProfessionalProfile?
  authorityProfile    AuthorityProfile?
  workerProfile       WorkerProfile?
  auditLogs           AuditLog[]
  reportedComplaints  Complaint[]
  authoredComments    Comment[]
}

model UserProfile {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone                   String?
  preferredWard           String?
  savedAddresses          String?
  notificationPreferences String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model ProfessionalProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String?
  profession         String?
  phone              String?
  serviceArea        String?
  experience         String?
  verificationStatus String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AuthorityProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department          String?
  designation         String?
  employeeId          String?
  wardOrZone          String?
  authorizationStatus String   @default("PENDING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model WorkerProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone              String?
  specialization     String?
  employeeRef        String?
  availabilityStatus String   @default("AVAILABLE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  publicId   String?
  role       String?
  action     String
  entityType String?
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Ward {
  id          String        @id
  name        String
  zone        String
  population  Int
  areaKm2     Float
  complaints  Complaint[]
  assets      RoadAsset[]
  hotspots    RoadHotspot[]
}

model Complaint {
  id           String     @id
  ticketNumber String     @unique
  description  String
  photoUrl     String?
  latitude     Float
  longitude    Float
  wardId       String
  ward         Ward       @relation(fields: [wardId], references: [id])
  roadType     String     // Residential, Local, Collector, Arterial
  upvoteCount  Int        @default(0)
  reportedAt   DateTime   @default(now())
  status       String     @default("PENDING") // PENDING, ASSIGNED, SCHEDULED, IN_PROGRESS, COMPLETED
  reporterId   String?
  reporter     User?      @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  workOrder    WorkOrder?
  comments     Comment[]
}

model Comment {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorName  String    @default("Citizen")
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  text        String
  createdAt   DateTime  @default(now())
}

model WorkOrder {
  id                 String     @id
  workOrderNumber    String     @unique
  complaintId        String     @unique
  complaint          Complaint  @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  severity           String     // CRITICAL, HIGH, MEDIUM, LOW
  severityScore      Float
  exposureScore      Float
  trafficScore       Float
  ageScore           Float
  crewProximityScore Float
  priorityScore      Float
  priorityBand       String     // CRITICAL, HIGH, MEDIUM, LOW
  assignedCrewId     String?
  assignedCrew       Crew?      @relation(fields: [assignedCrewId], references: [id])
  scheduledDate      DateTime?
  status             String     @default("PENDING") // PENDING, ASSIGNED, SCHEDULED, IN_PROGRESS, COMPLETED
  reasons            String     // JSON array of strings
  recommendation     String     @default("Repair today")
  estimatedDuration  Int        @default(90) // minutes
  assignedAt         DateTime?
  scheduledAt        DateTime?
  actualStartTime    DateTime?
  actualCompletedTime DateTime?
  actualDuration     Int?       // minutes
  completionNotes    String?
  sequence           Int?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  planItems          PlanItem[]
  decisions          AssignmentDecision[]
  overrides          AssignmentOverride[]
  evidencePhotos     PhotoEvidence[]
}

model Crew {
  id                 String     @id
  name               String
  members            Int
  specialization     String     // e.g. "Asphalt & surface repair", "General road maintenance"
  currentLatitude    Float
  currentLongitude   Float
  availabilityStatus String     @default("AVAILABLE") // AVAILABLE, BUSY, OFFLINE, ON_BREAK, FULL
  workingStart       String     @default("08:30")
  workingEnd         String     @default("17:00")
  dailyCapacity      Int        @default(4)
  assignedCount      Int        @default(0)

  workOrders         WorkOrder[]
  planItems          PlanItem[]
  users              User[]
}

model RoadAsset {
  id         String   @id
  type       String   // SCHOOL, HOSPITAL, BUS_STOP, MARKET, INTERSECTION, PUBLIC_AREA
  name       String
  latitude   Float
  longitude  Float
  importance Float    // 0 to 100
  wardId     String
  ward       Ward     @relation(fields: [wardId], references: [id])
}

model DailyPlan {
  id          String     @id
  date        String     // YYYY-MM-DD
  status      String     @default("GENERATED") // GENERATED, APPROVED, COMPLETED
  generatedAt DateTime   @default(now())
  items       PlanItem[]
}

model PlanItem {
  id                String    @id
  dailyPlanId       String
  dailyPlan         DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  workOrderId       String
  workOrder         WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  crewId            String
  crew              Crew      @relation(fields: [crewId], references: [id])
  sequence          Int
  scheduledStart    String    // e.g. "09:00"
  estimatedDuration Int       // in minutes
  travelDistanceKm  Float
  travelTimeMin     Int
  reason            String
}

model AssignmentDecision {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  crewId      String
  score       Float
  recommended Boolean   @default(true)
  reason      String
  createdAt   DateTime  @default(now())
}

model AssignmentOverride {
  id             String    @id @default(uuid())
  workOrderId    String
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  previousCrewId String?
  newCrewId      String
  reason         String
  createdAt      DateTime  @default(now())
}

model PhotoEvidence {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  type        String    // COMPLAINT, BEFORE, AFTER
  url         String
  storagePath String?
  uploadedBy  String?
  createdAt   DateTime  @default(now())
}

model RoadHotspot {
  id              String   @id @default(uuid())
  name            String
  latitude        Float
  longitude       Float
  radius          Float    @default(100.0) // in meters
  complaintCount  Int      @default(3)
  averageSeverity String   @default("HIGH")
  highestPriority Float    @default(85)
  wardId          String
  ward            Ward     @relation(fields: [wardId], references: [id])
  lastReportedAt  DateTime @default(now())
  createdAt       DateTime @default(now())
}
