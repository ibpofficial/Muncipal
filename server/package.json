{
  "name": "municipal-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "npx tsx watch src/server.ts",
    "build": "tsc",
    "postinstall": "npx prisma generate --schema=../prisma/schema.prisma",
    "start": "node dist/server.js",
    "prisma:generate": "npx prisma generate --schema=../prisma/schema.prisma",
    "prisma:push": "npx prisma db push --schema=../prisma/schema.prisma",
    "prisma:seed": "npx tsx ../prisma/seed.ts",
    "test": "npx vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "prisma": "^5.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
