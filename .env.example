DATABASE_URL="file:../prisma/dev.db"
PORT=5000
CLIENT_URL="http://localhost:5173"

# Firebase Client (Vite)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-app-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef"

# Firebase Admin SDK (Server)
FIREBASE_PROJECT_ID="your-app-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-app-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"

# Authority Allowlist & Invite Configuration
AUTHORIZED_AUTHORITY_EMAILS="officer@municipal.gov,admin@municipal.gov"
AUTHORIZED_AUTHORITY_DOMAIN="municipal.gov"
